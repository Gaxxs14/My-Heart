<?xml version="1.0" encoding="utf-8"?>
<!-- Pet Widget — compact 1x1 square -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pet_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Pet emoji big and centered -->
    <TextView
        android:id="@+id/widget_pet_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐶"
        android:textSize="26sp"
        android:gravity="center" />

    <!-- Pet name under emoji -->
    <TextView
        android:id="@+id/widget_pet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Corazoncito"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Level tiny below -->
    <TextView
        android:id="@+id/widget_pet_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Niv.1 💕"
        android:textColor="#E8FFFFFF"
        android:textSize="8sp"
        android:gravity="center" />

</LinearLayout>

