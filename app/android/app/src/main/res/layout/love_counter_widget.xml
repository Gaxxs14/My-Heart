<?xml version="1.0" encoding="utf-8"?>
<!-- Love Counter Widget — compact horizontal banner (2x1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- Heart emoji left -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="❤️"
        android:textSize="20sp"
        android:layout_marginEnd="8dp" />

    <!-- Days block center -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_days_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="días juntos"
            android:textColor="#E0FFFFFF"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- Names right side -->
    <TextView
        android:id="@+id/widget_couple_names"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tú &amp; Amor ♥"
        android:textColor="#FFE0FF"
        android:textSize="8sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:gravity="end|center_vertical" />

</LinearLayout>

