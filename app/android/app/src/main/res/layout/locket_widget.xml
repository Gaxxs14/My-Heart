<?xml version="1.0" encoding="utf-8"?>
<!-- Locket Widget — compact 1x1 square -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_locket_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Heart/photo emoji centered -->
    <TextView
        android:id="@+id/widget_locket_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💖"
        android:textSize="26sp"
        android:gravity="center" />

    <!-- Partner name or title -->
    <TextView
        android:id="@+id/widget_locket_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mi Amor 📸"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Short caption -->
    <TextView
        android:id="@+id/widget_locket_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pensando en ti..."
        android:textColor="#E8FFFFFF"
        android:textSize="8sp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>

